# Build output is never useful to consumers.
build/
example/build/

# The example's platform runners are kept in the repository so it can be run
# straight after a clone, but they are regenerated by `flutter create .` and
# would otherwise add a few hundred kilobytes of Xcode projects and app icons
# to every download.
example/android/
example/ios/
example/linux/
example/macos/
example/web/
example/windows/
example/*.iml
